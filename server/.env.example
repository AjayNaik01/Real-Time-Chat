# Server Configuration
PORT=3001
NODE_ENV=development

# Hidden Admin Command Center (SOC) Master Password
# Change this immediately before deploying to production
ADMIN_PASSWORD=admin-secret-2026

# -------------------------------------------------------------
# Optional Persistent Audit & Compliance Logging
# -------------------------------------------------------------

# Option A: PostgreSQL Persistence (Neon, Supabase, Render Postgres, AWS RDS)
# If provided, creates and appends to the `audit_logs` table automatically
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# Option B: Local Disk File Log Destination
# Defaults to `logs/audit.jsonl`
# AUDIT_LOG_FILE=logs/audit.jsonl

# Option C: Direct HTTP Webhook / SIEM / Datadog / Papertrail Forwarder
# If provided, sends non-blocking async POST requests with structured audit JSON
# AUDIT_WEBHOOK_URL=https://http-intake.logs.datadoghq.com/api/v2/logs?dd-api-key=...
